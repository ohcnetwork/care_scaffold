# Copy to <workspace>/care-scaffold.env before running configure-workspace.py.
# Set any ports you want to pin (integers 1024–65535); leave the rest blank.
# Setup checks explicit ports, allocates missing ports, and saves the complete set.
# All eight ports must be distinct. Ports bind to loopback only.

# CARE API and host frontend
CARE_API_PORT=
CARE_FE_PORT=

# First plugin's frontend preview
PLUGIN_PORT=

# PostgreSQL and Redis
CARE_DB_PORT=
CARE_REDIS_PORT=

# MinIO API (including browser uploads) and console
CARE_S3_PORT=
CARE_S3_CONSOLE_PORT=

# Backend debugger
CARE_DEBUG_PORT=

# Workspace paths, Compose project identity, API/frontend URLs and backup path
# are derived by configure-workspace.py. Change ports above, then rerun setup
# and refresh frontend/plugin wiring; do not maintain URLs separately.
